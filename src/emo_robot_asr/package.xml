<?xml version="1.0"?>
<package format="3">
  <name>emo_robot_asr</name>
  <version>0.1.0</version>
  <description>AimDK VAD microphone to remote ASR bridge.</description>
  <maintainer email="agi@todo.todo">agi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>aimdk_msgs</exec_depend>
  <exec_depend>python3-requests</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
